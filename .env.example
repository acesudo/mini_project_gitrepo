# Face Attendance System — Environment Variables

# Database Connection (SQLite default, PostgreSQL for production)
DATABASE_URL=sqlite:///data/attendance.db
# PostgreSQL Example: postgresql+psycopg2://user:password@localhost:5432/attendance_db

# Security & Authentication (Module 9)
# Generate a secure 256-bit random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to 'true' to enforce JWT bearer token authentication across API endpoints
AUTH_ENABLED=false

# Biometric HMAC Key (for verifying embedding vector integrity against tampering)
BIOMETRIC_HMAC_KEY=super_secure_biometric_integrity_key_change_in_prod

# Default Admin Credentials (created on first run if database has no admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.70
CORS_ORIGINS=*
